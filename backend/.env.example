# Postgres — Supabase ou Neon (usar driver asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Número de WhatsApp do MC, formato internacional, só dígitos
WHATSAPP_NUMBER=258876050602

APP_NAME=MC Booking API
ENVIRONMENT=development
CORS_ORIGINS=["*"]

# Token do painel admin (Authorization: Bearer <valor>)
# Gerar um valor forte, ex: openssl rand -hex 32
ADMIN_TOKEN=changeme-token

# Liga/desliga a exigência do token acima. Em fase de testes, pode pôr
# "false" para entrar no admin.html sem precisar de copiar o token.
# ANTES DE PUBLICAR O SITE, voltar a pôr "true" — sem isto, qualquer
# pessoa consegue mudar preços, ver pedidos de clientes, etc.
ADMIN_AUTH_ENABLED=true
